# ProTask 环境变量示例
# 用法：复制为仓库根目录的 .env（与 docker-compose.yml 同级），按需修改后执行 docker compose up -d
# 注意：.env 已在 .gitignore 中忽略；不要把真实密码 / 密钥提交到仓库

# ============================================================
# 一、Docker Compose 使用（放在根目录 .env 中会自动加载）
# ============================================================

# MySQL root 密码；docker compose 的 mysql 服务使用
# 必填：docker compose 启动时未设置会直接报错
PROTASK_DB_ROOT_PASSWORD=

# 后端使用的数据库账号密码；宿主机 MySQL 场景填独立业务账号（不要用 root）
# 必填：docker compose 启动 server 时校验；容器 MySQL 场景填成与上面 root 密码相同的值
PROTASK_DB_PASSWORD=

# JWT 签名密钥；必填，使用随机长字符串（例如 openssl rand -base64 48），不要使用示例值
# 注意：更换该密钥会让所有已登录用户的 token 立即失效，上线后固定不要再改
PROTASK_JWT_SECRET=

# 首次启动初始化管理员账号的密码（可选）：留空则随机生成，并在首次启动日志中打印一次
# 要求：至少 8 位且包含大小写字母 / 数字 / 特殊字符中的 3 类
# PROTASK_ADMIN_PASSWORD=

# ============================================================
# 二、后端连接外部/宿主机 MySQL 时使用（本地直跑或宿主机部署）
#     docker compose 会读取这三项作为覆盖值；不设置则回退到 compose 内置的
#     mysql 服务（服务名 mysql + root 账号）。
# ============================================================

# 本地直跑：需先启动 docker compose up -d mysql（映射到 127.0.0.1:3306）
# 宿主机 MySQL：把主机名换成 127.0.0.1，并按下面注释补齐 UTC 会话时区参数
PROTASK_DB_URL=jdbc:mysql://localhost:3306/protask?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false

# 数据库账号；宿主机部署建议单独建业务账号，仅授权 protask 库
PROTASK_DB_USER=root

# 数据库密码；与上面的 PROTASK_DB_PASSWORD 为同一项
# 【宿主机 MySQL 必改】容器版 MySQL 启动时带了 --default-time-zone=+00:00，宿主机通常跟随系统时区（+08:00）。
# 建表脚本里大量 DATETIME DEFAULT CURRENT_TIMESTAMP 由数据库时区决定，必须保证与应用的 UTC 口径一致：
#   方案一（推荐，只影响本连接）：URL 追加 &connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
#   方案二：my.cnf 设 default-time-zone='+00:00'（会影响同机其他站点，慎用）
PROTASK_DB_PASSWORD=

# JVM 默认时区；要求跨时区存储口径一致，保持 UTC
PROTASK_TIMEZONE=UTC

# ============================================================
# 三、MCP 服务（stdio）使用
# ============================================================

# 后端地址：直跑默认 http://localhost:8000；MCP 容器内用 http://server:8000
PROTASK_BASE_URL=http://localhost:8000

# 登录凭证方式一：直接给账号密码（管理员初始密码见后端首次启动日志或 PROTASK_ADMIN_PASSWORD 配置）
PROTASK_USERNAME=admin
PROTASK_PASSWORD=

# 登录凭证方式二（推荐，避免在 MCP 客户端配置中写明文）：指向凭证 JSON 文件
# 文件格式：{ "username": "...", "password": "...", "baseUrl": "http://localhost:8000" }
# 设置此项后优先于 PROTASK_USERNAME / PROTASK_PASSWORD
# PROTASK_CREDS_FILE=d:/ProTask/mcp/creds.json

# ============================================================
# 四、前端（webapp）
# ============================================================
# 前端无需环境变量：开发环境由 Vite 代理 /api 到 localhost:8000，
# 生产环境由容器 nginx 反代到 server:8000，宿主机 nginx 部署则反代到 127.0.0.1:8000。

# ============================================================
# 五、文件存储后端（本地磁盘 / 阿里云 OSS）
# ============================================================
# local：文件写入容器内 uploads 与 uploads-attachments（compose 已挂 named volume 持久化）
# oss  ：文件写入阿里云 OSS，公开图片仍以 /api/v1/upload/files/{filename} 同源返回，
#        因此库内 Markdown 里的图片 URL 不受切换影响，无需数据迁移
# PROTASK_STORAGE_BACKEND=local

# OSS 接入点：同地域 ECS 用内网域名（如 oss-cn-hangzhou-internal.aliyuncs.com）免公网流量费
# PROTASK_OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com

# RAM 子账号凭证：建议仅授予下列两个桶的 GetObject/PutObject/DeleteObject/ListObjects 权限
# PROTASK_OSS_ACCESS_KEY_ID=
# PROTASK_OSS_ACCESS_KEY_SECRET=

# 公开图片桶与私有附件桶：附件桶必须为「私有」读写权限。
# 注意 OSS 的读写权限是桶级的：同桶不同前缀只能让应用自身的匿名图片接口读不到附件，
# 并不能阻止知道对象 URL 的人直接从 OSS 域名下载。因此「公有读」的桶只能放公开图片，
# 非图片附件必须放独立的私有桶（同桶同前缀会被 FileStorageConfig 启动校验直接拒绝）。
# PROTASK_OSS_PUBLIC_BUCKET=protask-public
# PROTASK_OSS_PRIVATE_BUCKET=protask-private

# 对象 key 前缀：库内 stored_name 存的是前缀之后的相对路径，上线后不要再改（改了旧文件会取不到）
# PROTASK_OSS_PUBLIC_PREFIX=uploads/
# PROTASK_OSS_PRIVATE_PREFIX=attachments/

# ============================================================
# 六、孤儿图片检测（默认关闭）
# ============================================================
# 关闭时管理后台不展示孤儿图片统计与清理入口，也不会全表扫描文本或查询对象大小；
# 需要回收无引用的 Markdown 插图时临时开启，用完关掉（清理不可逆）。
# 注意：关闭后上传未使用的图片会一直留在存储桶里，需自行按需清理。
# PROTASK_STORAGE_ORPHAN_CHECK=true
