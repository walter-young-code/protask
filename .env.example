# ProTask 环境变量示例
# 用法：复制为仓库根目录的 .env（与 docker-compose.yml 同级），按需修改后执行 docker compose up -d
# 注意：.env 已在 .gitignore 中忽略；不要把真实密码 / 密钥提交到仓库

# ============================================================
# 一、Docker Compose 使用（放在根目录 .env 中会自动加载）
# ============================================================

# MySQL root 密码；同时作为 server 容器的数据库密码（PROTASK_DB_PASSWORD）
# 必填：docker compose 启动时未设置会直接报错
PROTASK_DB_ROOT_PASSWORD=

# JWT 签名密钥；必填，使用随机长字符串（例如 openssl rand -base64 48），不要使用示例值
PROTASK_JWT_SECRET=

# 首次启动初始化管理员账号的密码（可选）：留空则随机生成，并在首次启动日志中打印一次
# 要求：至少 8 位且包含大小写字母 / 数字 / 特殊字符中的 3 类
# PROTASK_ADMIN_PASSWORD=

# ============================================================
# 二、后端本地直跑使用（mvn spring-boot:run，不通过 compose）
#     这些变量需在 shell 中单独设置（PowerShell: $env:XXX="..."），
#     docker compose 不会读取它们（compose 内已固定为服务名 mysql）。
# ============================================================

# JDBC 连接串；本地需先启动 docker compose up -d mysql（映射到 127.0.0.1:3306）
PROTASK_DB_URL=jdbc:mysql://localhost:3306/protask?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false

# 数据库账号
PROTASK_DB_USER=root

# 数据库密码；需与上面的 PROTASK_DB_ROOT_PASSWORD 一致
PROTASK_DB_PASSWORD=

# JVM 默认时区；要求跨时区存储口径一致，保持 UTC
PROTASK_TIMEZONE=UTC

# ============================================================
# 三、MCP 服务（stdio）使用
# ============================================================

# 后端地址：直跑默认 http://localhost:8000；MCP 容器内用 http://server:8000
PROTASK_BASE_URL=http://localhost:8000

# 登录凭证方式一：直接给账号密码（管理员初始密码见后端首次启动日志或 PROTASK_ADMIN_PASSWORD 配置）
PROTASK_USERNAME=admin
PROTASK_PASSWORD=

# 登录凭证方式二（推荐，避免在 MCP 客户端配置中写明文）：指向凭证 JSON 文件
# 文件格式：{ "username": "...", "password": "...", "baseUrl": "http://localhost:8000" }
# 设置此项后优先于 PROTASK_USERNAME / PROTASK_PASSWORD
# PROTASK_CREDS_FILE=d:/ProTask/mcp/creds.json

# ============================================================
# 四、前端（webapp）
# ============================================================
# 前端无需环境变量：开发环境由 Vite 代理 /api 到 localhost:8000，
# 生产环境由 nginx 反代到 server:8000，均写在配置文件中。
