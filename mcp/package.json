{
  "name": "protask-mcp",
  "version": "1.0.0",
  "description": "ProTask MCP server with write-format guard for AI agents",
  "type": "module",
  "bin": {
    "protask-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist-bundle/protask-mcp.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-package.ps1",
    "package-setup": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-setup.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
